{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": { "includes": ["**", "!.next", "!node_modules", "!next-env.d.ts"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "useSemanticElements": "off" },
      "suspicious": { "noArrayIndexKey": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [{ "includes": ["app/globals.css"], "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } } }],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
